{
  "name": "@lattice-hub/pole-client-nodejs",
  "version": "0.2.0",
  "description": "Framework-neutral Pole Thin SDK for Node.js",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lattice-hub/pole-client-nodejs.git"
  },
  "homepage": "https://github.com/lattice-hub/pole-client-nodejs#readme",
  "bugs": {
    "url": "https://github.com/lattice-hub/pole-client-nodejs/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1"
  }
}
